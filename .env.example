# Copy this file to .env and fill in your own values. .env is git-ignored.

# Alpha Vantage — free API key for news sentiment (https://www.alphavantage.co/support/#api-key)
ALPHA_VANTAGE_KEY=

# Gmail SMTP — used to send the alert emails.
# GMAIL_APP_PASSWORD is a 16-character Google App Password, NOT your account password.
# Generate one at: Google Account -> Security -> 2-Step Verification -> App Passwords
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Where alerts are sent. Optional — defaults to GMAIL_USER if left blank.
EMAIL_TO=

# Model used for the headless reasoning run (invoked via the `claude` CLI).
# Optional — defaults to claude-opus-4-8.
PORTFOLIO_AGENT_MODEL=
